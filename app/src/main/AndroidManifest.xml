<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 本地音频读取 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      「播放并下载」在 **Android 9 及以下**需要它才能写进公开音乐目录。
      Android 10（API 29）起走 MediaStore 插入自己的媒体文件，
      **完全不需要权限**，所以这里用 maxSdkVersion 把范围限死 ——
      新系统上它连声明都不会生效，用户不会看到这条权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 音频可视化：读取本应用音频会话的频谱（Visualizer 不需要录音权限） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      联网能力，三处用途，**全部默认关闭**，只有用户在设置里显式打开才会用到：
      ① 在线歌词（LrcAPI）② 在线封面（iTunes）③ 在线音乐（搜索 + 播放）。
      三个都关着时不会发出任何请求，播放器依旧是纯本地的。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 后台播放与通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 睡眠定时：到点精确唤醒停播。Android 12+ 用户未授权精确闹钟时自动降级为 while-idle 闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 黑胶模式的触感反馈（install-time 普通权限） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 比亚迪 DiLink 仪表盘/媒体中心隐藏扩展；非比亚迪车机上无意义，声明后不报错 -->
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <!-- 桌面歌词悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Shizuku：以 shell 身份读 B 站缓存目录（Android/data/tv.danmaku.bilibilihd）。
      Android 11+ 普通应用无法访问其他应用的 Android/data，shell 是免 root 的唯一通道。
      没有装 Shizuku 或没授权时这条权限不生效，功能会自动降级为「未就绪」提示。
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />


    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="false" />

    <!-- Android 11+ 包可见性：查询手机/平板系统音效面板（杜比/厂商音效）与声音设置 -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <package android:name="com.dolby.daxappui" />
        <package android:name="com.motorola.dolby.dolbyui" />
        <package android:name="com.sec.android.app.soundalive" />
        <package android:name="com.miui.misound" />
        <package android:name="com.oplus.melody" />
        <package android:name="com.oneplus.sound.tuner" />
        <package android:name="com.android.musicfx" />
    </queries>

    <application
        android:name=".SonanceApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/sonance_backup_rules"
        android:dataExtractionRules="@xml/sonance_data_extraction"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:theme="@style/Theme.Sonance"
        tools:targetApi="35">

        <!-- ColorOS / OPlus 部分版本会过滤未登记播放器的媒体历史，导致锁屏歌词入口不出现。
             这是社区协议里的可选 opt-in：只影响媒体历史策略，不伪装包名、不申请权限。 -->
        <meta-data
            android:name="io.github.andrealtb.lockscreenlyrics.OPLUS_MEDIA_HISTORY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Sonance">
            <!-- 桌面启动入口：直接挂在 MainActivity，避免包名变更后 alias 目标失效 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 让 BYD 媒体中心/语音把本应用识别成音乐播放器（不会多出桌面图标） -->
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!-- 支持从文件管理器用本播放器打开音频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
                <data android:mimeType="application/itunes" />
            </intent-filter>
            <!-- 兜底：部分文件管理器不带 MIME type，直接用 file/content + 扩展名打开音频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.MP3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.FLAC" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.M4A" />
                <data android:pathPattern=".*\\.m4b" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.AAC" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.OGG" />
                <data android:pathPattern=".*\\.oga" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.OPUS" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.WAV" />
                <data android:pathPattern=".*\\.amr" />
                <data android:pathPattern=".*\\.mka" />
                <data android:pathPattern=".*\\.weba" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          视频「锁屏 / 后台继续播放」的前台服务。
          只负责把进程钉住 + 提供媒体通知（播放/暂停、上一首/下一首、进度），
          播放器仍然只有 BiliVideoSession 里的那一个实例。
        -->
        <service
            android:name=".playback.BiliVideoService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


        <!--
          B 站缓存的全屏播放页。
          独立 Activity 而不是在主界面里翻横屏：主界面是三档布局（手机 / 中屏 / 平板），
          跟着转会把整套侧栏和播放面板一起横过来；独立页只关心一块 Surface 和一层控制条。
        -->
        <activity
            android:name=".ui.VideoPlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.Sonance"
            android:supportsPictureInPicture="true" />

        <!-- Shizuku 的权限回调 provider。authorities 必须带包名前缀，不能和别的应用冲突 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!--
          把下载的封面交给通知栏 / 锁屏用的 FileProvider。

          下载的封面存在应用私有目录（files/cover_cache），系统进程读不到 File，
          而 MediaSession 只认 URI 或位图 —— 所以经这里转成 content:// URI。
          authority 与 CoverCache.contentUri 里的 "${包名}.covers" 必须一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          桌面小组件的播控 / 歌词命令入口。
          只接收本应用自己发出的显式 intent，所以不导出、也不声明 intent-filter。
          小组件不走 MediaButtonReceiver：media3 在 API 26+ 会丢掉非播放类按键。
        -->
        <receiver
            android:name=".widget.WidgetCommandReceiver"
            android:exported="false" />

        <!-- 睡眠定时到点的系统闹钟入口：只接收本应用 PendingIntent 的显式 intent -->
        <receiver
            android:name=".playback.SleepTimerReceiver"
            android:exported="false" />

        <!--
          桌面歌词通知栏快捷操作（解锁 / 关闭歌词）入口。
          ⚠️ 不注册的话通知按钮的广播会发给不存在的组件，点了没有任何反应。
        -->
        <receiver
            android:name=".desktoplyrics.DesktopLyricsReceiver"
            android:exported="false" />

        <!--
          ===== 桌面小组件：5 列保留（5 套）+ 4 列新增（5 套），共计 10 套独立样式 =====
        -->
        <receiver
            android:name=".widget.SonanceWidgetBar"
            android:exported="false"
            android:label="@string/widget_label_bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bar_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetCard"
            android:exported="false"
            android:label="@string/widget_label_card">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_card_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetWide"
            android:exported="false"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetMinimal"
            android:exported="false"
            android:label="@string/widget_label_minimal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetLarge"
            android:exported="false"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <!-- 新增 4 列系列（2×1 / 4×1 / 2×2 / 4×2 / 4×4） -->
        <receiver
            android:name=".widget.SonanceWidgetBar4"
            android:exported="false"
            android:label="@string/widget_label_bar_4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bar_4_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetCard4"
            android:exported="false"
            android:label="@string/widget_label_card_4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_card_4_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetWide4"
            android:exported="false"
            android:label="@string/widget_label_wide_4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_4_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetMinimal4"
            android:exported="false"
            android:label="@string/widget_label_minimal_4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_4_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetLarge4"
            android:exported="false"
            android:label="@string/widget_label_large_4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_4_info" />
        </receiver>
